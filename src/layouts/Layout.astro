---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { Navbar } from "../components/Navbar";
import Footer from "../components/Footer.astro";
import { WhatsAppButton } from "../components/WhatsAppButton";
import { Breadcrumbs } from "../components/Breadcrumbs";
import { LIGHT_PRODUCTS } from "../data/products/products";


interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Compresores del Valle - Venta, mantenimiento y reparación de compresores en Cali y el Valle del Cauca.",
  image = "/branding/logoCompresores1.webp",
} = Astro.props;

const optimizedTitle = title.includes("Compresores del Valle")
  ? title
  : `${title} | Compresores del Valle`;
// 1. URL CANÓNICA

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 2. IMAGEN SOCIAL
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.webp"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.webp"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.webp"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- --- SEO BÁSICO --- -->
    <title>{optimizedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- --- OPEN GRAPH / FACEBOOK / WHATSAPP --- -->
    <meta
      property="og:type"
      content={Astro.url.pathname.startsWith("/producto")
        ? "product"
        : "website"}
    />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={optimizedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="Compresores del Valle" />
    <meta property="og:locale" content="es_CO" />

    <!-- --- TWITTER --- -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={optimizedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <ClientRouter />

    <!-- --- SCHEMA.ORG (DATOS ESTRUCTURADOS) --- -->
    <!-- Se muestra en Home y Contacto para definir el negocio local -->
    {
      (Astro.url.pathname === "/" || Astro.url.pathname === "/contacto") && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            name: "Compresores del Valle",
            image: socialImageURL, // Usa la URL generada
            telephone: "+573127536787",
            priceRange: "$$", // Ayuda a Google a saber el rango de precios
            address: {
              "@type": "PostalAddress",
              streetAddress: "Calle 34 #4B-30",
              addressLocality: "Cali",
              addressRegion: "Valle del Cauca",
              addressCountry: "CO",
            },
            geo: {
              "@type": "GeoCoordinates",
              latitude: 3.4516,
              longitude: -76.532,
            },
            openingHoursSpecification: [
              {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                ],
                opens: "07:30",
                closes: "18:00",
              },
              {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: "Saturday",
                opens: "08:00",
                closes: "15:00",
              },
            ],
            areaServed: "Colombia",
            url: canonicalURL,
          })}
        />
      )
    }
  </head>

  <body class="min-h-screen flex flex-col overflow-x-hidden bg-slate-50">
    <!-- Navbar Fijo -->
    <div transition:persist>
      <Navbar searchData={LIGHT_PRODUCTS} client:idle />
    </div>

    <!-- Botón WhatsApp Fijo -->
    <div transition:persist>
      <WhatsAppButton client:visible />
    </div>

    <!-- Contenedor Maestro para espaciado superior -->
    <div class="pt-30 md:pt-48.5 flex-1 flex flex-col">
      <!-- Breadcrumbs -->
      <Breadcrumbs client:idle />

      <!-- Contenido Principal -->
      <main class="flex-1 w-full" transition:animate="fade">
        <slot />
      </main>
    </div>

    <!-- Footer -->
    <Footer />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
