---
import Layout from "../layouts/Layout.astro";
import { TEAM } from "../data/nosotros/nosotros";
import { NosotrosHeroCarousel } from "../components/NosotrosHeroCarousel";
import { Eye, Rocket, Handshake, CircleCheck, Lightbulb } from "lucide-react";
import { MdOutlineVerified } from "react-icons/md";

// Definimos los valores aquí
const values = [
  {
    t: "Integridad",
    d: "Honestidad radical en cada diagnóstico y cotización.",
    i: Handshake,
  },
  {
    t: "Calidad",
    d: "Ofrecemos productos y servicios de la más alta calidad, superando las expectativas de nuestros clientes.",
    i: CircleCheck,
  },
  {
    t: "Innovación",
    d: "Siempre buscamos nuevas formas de mejorar y ofrecer soluciones avanzadas.",
    i: Lightbulb,
  },
  {
    t: "Respaldo",
    d: "Acompañamiento técnico real y garantía efectiva en cada producto y servicio que entregamos.",
    i: MdOutlineVerified,
  },
];
---

<Layout
  title="Nosotros | Compresores del Valle | Expertos en Compresores Industriales"
  description="Conoce Compresores del Valle, empresa con amplia trayectoria en la venta, mantenimiento y reparación de compresores industriales. Atención desde Cali con cobertura nacional."
>
  <div class="space-y-32 pb-24 pt-12">
    <!-- HEADER SECTION -->
    <header
      class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center"
    >
      <div class="space-y-8">
        <div class="space-y-4">
          <span
            class="bg-yellow-100 text-[#013189] px-3 py-1 rounded-full font-black uppercase tracking-[0.3em] text-sm"
            >Trayectoria en el Valle</span
          >
          <h1
            class="text-6xl md:text-8xl font-black text-(--brand-blue) uppercase tracking-tighter"
          >
            POTENCIA <br />QUE MUEVE <br /><span
              class="text-(--brand-yellow) drop-shadow-[0_2px_2px_rgba(0,0,0,0.35)]"
              style="-webkit-text-stroke: 2px #013189;">EL PAÍS</span
            >
          </h1>
        </div>
        <p class="text-slate-500 text-xl leading-relaxed">
          Desde Cali, <strong>Compresores del Valle S.A.S.</strong> se ha consolidado
          como el socio estratégico preferido de la industria manufacturera, agroindustrial
          y de servicios en todo el suroccidente colombiano.
        </p>
        <div class="flex gap-12 pt-4">
          <div>
            <p class="text-5xl font-black text-(--brand-blue)">25+</p>
            <p
              class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-2"
            >
              Años Líderes
            </p>
          </div>
          <div>
            <p class="text-5xl font-black text-(--brand-blue)">500+</p>
            <p
              class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-2"
            >
              Clientes Activos
            </p>
          </div>
        </div>
      </div>

      <div class="relative">
        <div
          class="absolute inset-0 bg-(--brand-blue) rounded-[5rem] rotate-3 translate-x-4 opacity-10"
        >
        </div>
        <NosotrosHeroCarousel client:idle />
      </div>
    </header>

    <!-- MISSION / VISION -->
    <section class="bg-slate-50 py-32 px-4">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
        <div
          class="bg-white p-16 rounded-[4rem] shadow-sm border border-slate-100 space-y-8 hover:shadow-2xl transition-all group"
        >
          <div
            class="size-20 rounded-3xl bg-blue-50 flex items-center justify-center text-(--brand-blue) group-hover:scale-110 transition-transform"
          >
            <Rocket className="size-10" />
          </div>
          <h2
            class="text-4xl font-black text-(--brand-blue) uppercase tracking-tight"
          >
            Misión
          </h2>
          <p class="text-slate-500 text-lg leading-relaxed italic">
            "En Compresores del Valle diseñamos, suministramos e implementamos
            soluciones técnicas especializadas en sistemas de aire comprimido y
            herramientas neumáticas, integrando comercialización, mantenimiento
            industrial, reparación y ensamble bajo estándares rigurosos de
            calidad, eficiencia operativa y confiabilidad técnica.<br /><br />
            Impulsamos la productividad de nuestros clientes mediante asesoría experta,
            soporte técnico especializado y mejora continua en cada proceso."
          </p>
        </div>
        <div
          class="bg-white p-16 rounded-[4rem] shadow-sm border border-slate-100 space-y-8 hover:shadow-2xl transition-all group"
        >
          <div
            class="size-20 rounded-3xl bg-yellow-50 flex items-center justify-center text-(--brand-yellow) group-hover:scale-110 transition-transform"
          >
            <Eye className="size-10" />
          </div>
          <h2
            class="text-4xl font-black text-(--brand-blue) uppercase tracking-tight"
          >
            Visión
          </h2>
          <p class="text-slate-500 text-lg leading-relaxed italic">
            "Ser una empresa referente a nivel nacional en soluciones integrales
            de aire comprimido, reconocida por su liderazgo técnico, innovación
            tecnológica y excelencia en el servicio especializado.<br /><br />
            Nos proyectamos como una organización sólida, competitiva y en constante
            evolución, comprometida con el desarrollo industrial y el crecimiento
            sostenible del sector."
          </p>
        </div>
      </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="max-w-7xl mx-auto px-4 text-center space-y-14">
      <h2
        class="text-5xl font-black text-(--brand-blue) uppercase tracking-tighter"
      >
        Nuestros Valores
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
        {
          values.map((v) => (
            <div class="space-y-6">
              <div class="size-24 rounded-full bg-slate-100 mx-auto flex items-center justify-center text-(--brand-blue)">
                <v.i className="size-12" />
              </div>
              <h3 class="text-2xl font-black uppercase text-(--brand-blue)">
                {v.t}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed">{v.d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- TEAM GRID -->
    <section class="bg-(--brand-blue) py-32 text-white">
      <div class="max-w-7xl mx-auto px-4 text-center space-y-24">
        <div class="space-y-6">
          <h2 class="text-5xl font-black uppercase tracking-tighter">
            Nuestro Equipo
          </h2>
          <p class="text-blue-100 text-xl max-w-2xl mx-auto">
            Contamos con personal técnico altamente capacitado, con amplia
            experiencia en mantenimiento, reparación e instalación de sistemas
            de aire comprimido. Trabajamos de manera coordinada para ofrecer
            soluciones eficientes y confiables a nuestros clientes..
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
          {
            TEAM.map((p) => {
              const ImageSrc =
                typeof p.image === "string" ? p.image : p.image.src;
              return (
                <div class="space-y-6 group">
                  <div class="aspect-4/5 rounded-[3rem] overflow-hidden shadow-2xl">
                    <img
                      src={ImageSrc}
                      class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
                      alt={p.name}
                      loading="lazy"
                    />
                  </div>
                  <div class="space-y-2">
                    <h3 class="text-2xl font-black">{p.name}</h3>
                    <span class="text-(--brand-yellow) font-black uppercase tracking-[0.2em] text-xs">
                      {p.role}
                    </span>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* 
     Esta clase fuerza el tamaño de los iconos de Google.
     A veces Tailwind text-5xl no funciona bien con iconos de fuente si hay conflictos de CSS.
     Esto asegura que se vean grandes.
  */
  .icon-fix {
    font-size: 48px !important;
    line-height: 1;
  }
</style>
