---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <span class="material-symbols-outlined text-9xl text-[#FFD600] mb-4">
      warning
    </span>
    <h1 class="text-5xl font-black text-[#2553A8] uppercase mb-4">Error 404</h1>
    <p class="text-slate-500 text-lg mb-8 max-w-md">
      Parece que la página o el equipo que buscas ya no está disponible o la dirección es incorrecta.
    </p>
    <a href="/" class="bg-[#2553A8] text-white px-8 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-[#1a3d7c] transition-colors shadow-lg">
      Volver al Inicio
    </a>
  </div>
</Layout>